    <enableSearch>false</enableSearch>
    <externalSharingModel>Private</externalSharingModel>
    <label>Expense Claim Access</label>
    <nameField>
        <displayFormat>ECA-{000000}</displayFormat>
        <label>Expense Claim Access Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Expense Claim Access</pluralLabel>
    <sharingModel>Private</sharingModel>
</CustomObject>