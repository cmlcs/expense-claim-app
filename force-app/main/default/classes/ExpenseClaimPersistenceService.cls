/**
 * Enforces claimant input permissions and persists prepared Expense Claims.
 */
public inherited sharing class ExpenseClaimPersistenceService {

    /**
     * Sanitizes claimant-controlled Expense Claim input.
     *
     * @param claim Unsanitized Expense Claim.
     * @return Sanitized Expense Claim.
     */
    public static Expense_Claim__c sanitizeClaimInput(
        Expense_Claim__c claim
    ) {
        SObjectAccessDecision decision =
            Security.stripInaccessible(
                AccessType.CREATABLE,
                new List<SObject>{ claim },
                true
            );

        requireNoRemovedFields(decision);

        return (Expense_Claim__c)
            decision.getRecords()[0];
    }

    /**
     * Sanitizes claimant-controlled Expense Item input.
     *
     * @param items Unsanitized Expense Items.
     * @return Sanitized Expense Items.
     */
    public static List<Expense_Item__c> sanitizeItemInput(
        List<Expense_Item__c> items
    ) {
        if (items.isEmpty()) {
            return items;
        }

        List<SObject> sourceRecords =
            new List<SObject>();

        for (Expense_Item__c item : items) {
            sourceRecords.add(item);
        }

        SObjectAccessDecision decision =
            Security.stripInaccessible(
                AccessType.CREATABLE,
                sourceRecords,
                true
            );

        requireNoRemovedFields(decision);

        return toExpenseItems(
            decision.getRecords()
        );
    }

    /**
     * Persists a trusted, server-prepared Expense Claim and its items.
     *
     * System mode is intentional because claimant-controlled fields were
     * already sanitized and remaining protected fields were generated by
     * server-side domain services.
     *
     * @param claim Prepared Expense Claim.
     * @param items Prepared Expense Items.
     */
    public static void persistSubmission(
        Expense_Claim__c claim,
        List<Expense_Item__c> items
    ) {
        requireClaimCreatePermission();
        requireItemCreatePermission();

        Database.insert(
            claim,
            true,
            AccessLevel.SYSTEM_MODE
        );

        applyParentId(
            items,
            claim.Id
        );

        Database.insert(
            items,
            true,
            AccessLevel.SYSTEM_MODE
        );
    }

    /**
     * Rejects input containing fields unavailable to the claimant.
     *
     * @param decision Result returned by stripInaccessible.
     */
    private static void requireNoRemovedFields(
        SObjectAccessDecision decision
    ) {
        if (!decision.getRemovedFields().isEmpty()) {
            throw new ExpenseClaimService.ExpenseClaimException(
                'You do not have permission to provide one or more Expense Claim fields.'
            );
        }
    }

    /**
     * Requires Expense Claim create permission.
     */
    private static void requireClaimCreatePermission() {
        Boolean createable =
            Expense_Claim__c.SObjectType
                .getDescribe(
                    SObjectDescribeOptions.DEFERRED
                )
                .isCreateable();

        if (!createable) {
            throw new ExpenseClaimService.ExpenseClaimException(
                'You do not have permission to create Expense Claims.'
            );
        }
    }

    /**
     * Requires Expense Item create permission.
     */
    private static void requireItemCreatePermission() {
        Boolean createable =
            Expense_Item__c.SObjectType
                .getDescribe(
                    SObjectDescribeOptions.DEFERRED
                )
                .isCreateable();

        if (!createable) {
            throw new ExpenseClaimService.ExpenseClaimException(
                'You do not have permission to create Expense Items.'
            );
        }
    }

    /**
     * Applies the parent Expense Claim ID to prepared items.
     *
     * @param items Expense Items.
     * @param claimId Persisted Expense Claim ID.
     */
    private static void applyParentId(
        List<Expense_Item__c> items,
        Id claimId
    ) {
        for (Expense_Item__c item : items) {
            item.Expense_Claim__c =
                claimId;
        }
    }

    /**
     * Converts generic sanitized SObjects back to Expense Items.
     *
     * @param records Sanitized records.
     * @return Sanitized Expense Items.
     */
    private static List<Expense_Item__c> toExpenseItems(
        List<SObject> records
    ) {
        List<Expense_Item__c> items =
            new List<Expense_Item__c>();

        for (SObject recordValue : records) {
            items.add(
                (Expense_Item__c) recordValue
            );
        }

        return items;
    }
}